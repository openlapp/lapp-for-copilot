+function temporaryRoot(): string {
+  const root = fs.mkdtempSync(path.join(process.cwd(), ".manager-v2-test-"));
+  roots.push(root);
+  return root;
+}
+
+function uuid(n: number): string {
+  return `00000000-0000-4000-8000-${String(n).padStart(12, "0")}`;
