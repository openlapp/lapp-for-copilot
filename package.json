{
  "name": "lapp-for-copilot",
  "displayName": "OpenLAPP for Copilot",
  "description": "Bring local OpenLAPP providers and models into GitHub Copilot Chat on Windows x64.",
  "version": "0.1.0",
  "publisher": "openlapp",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/openlapp/lapp-for-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/openlapp/lapp-for-copilot/issues"
  },
  "homepage": "https://github.com/openlapp/lapp-for-copilot#readme",
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "vscode": "^1.128.1",
    "node": ">=18.18.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "openlapp",
    "lapp",
    "copilot",
    "language-model",
    "byok"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:openlapp",
    "onCommand:openlapp.openManager",
    "onCommand:openlapp.copyDiagnostics"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "openlapp",
        "displayName": "OpenLAPP",
        "managementCommand": "openlapp.openManager"
      }
    ],
    "commands": [
      {
        "command": "openlapp.openManager",
        "title": "OpenLAPP: Open Manager",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openlapp.refreshModels",
        "title": "OpenLAPP: Refresh Models",
        "icon": "$(refresh)"
      },
      {
        "command": "openlapp.copyDiagnostics",
        "title": "OpenLAPP: Copy Diagnostics Report",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "openlapp.openManager"
        },
        {
          "command": "openlapp.refreshModels"
        },
        {
          "command": "openlapp.copyDiagnostics"
        }
      ],
      "editor/title": [
        {
          "command": "openlapp.refreshModels",
          "when": "activeWebviewPanelId == 'openlapp.manager'",
          "group": "navigation@1"
        },
        {
          "command": "openlapp.copyDiagnostics",
          "when": "activeWebviewPanelId == 'openlapp.manager'",
          "group": "navigation@2"
        },
        {
          "command": "openlapp.openManager",
          "when": "activeWebviewPanelId == 'openlapp.manager'",
          "group": "navigation@3"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "openlapp.gettingStarted",
        "title": "OpenLAPP for Copilot",
        "description": "Connect a local LAPP profile to Copilot Chat without leaving VS Code.",
        "steps": [
          {
            "id": "open-manager",
            "title": "Open the Manager",
            "description": "Review the local LAPP profile, Vault status, and eligible Copilot models.\n[Open Manager](command:openlapp.openManager)",
            "media": {
              "markdown": "walkthrough/open-manager.md"
            }
          },
          {
            "id": "add-provider",
            "title": "Add a provider and model",
            "description": "Create a provider, store the credential in the system Vault, and enable a text model with explicit capabilities.",
            "media": {
              "markdown": "walkthrough/add-provider.md"
            }
          },
          {
            "id": "use-copilot",
            "title": "Use the model in Copilot",
            "description": "Pick ``openlapp/<hashed-id>`` in Copilot Chat. Agent mode, tools, streaming, and image input follow the model's declared capabilities.",
            "media": {
              "markdown": "walkthrough/use-copilot.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p webview/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "pnpm build:icon && pnpm build:host && pnpm build:webview",
    "test:unit": "vitest run --config vitest.config.ts test/unit",
    "test:webview": "vitest run --config vitest.config.ts test/webview",
    "test:wire": "vitest run --config vitest.config.ts test/mock-wire",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:1.128": "node scripts/run-integration.mjs --version 1.128.1",
    "test:integration:1.133": "node scripts/run-integration.mjs --version 1.133.0",
    "test:ui-smoke": "node scripts/run-ui-smoke.mjs",
    "test": "pnpm test:unit && pnpm test:webview && pnpm test:wire",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "package": "node scripts/package-vsix.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "ci": "pnpm check && pnpm build && pnpm test:integration && pnpm package && pnpm verify:vsix && pnpm test:ui-smoke",
    "push": "git push origin HEAD",
    "push:tags": "git push origin --tags",
    "push:all": "git push origin HEAD && git push origin --tags",
    "release:tag": "node scripts/cut-release.mjs",
    "release:push": "node scripts/cut-release.mjs --push",
    "release:publish": "gh workflow run release.yml --repo openlapp/lapp-for-copilot"
  },
  "dependencies": {
    "@openlapp/lapp": "file:vendor/openlapp-lapp-0.1.3-copilot.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "@types/vscode": "1.125.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.25.8",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-eslint-parser": "^10.2.0",
    "vscode-extension-tester": "^8.16.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/keyring"
    ]
  }
}
